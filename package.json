{
  "name": "hamashbir-season-portal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "wrangler dev --port 3100",
    "deploy": "npm run build && wrangler deploy",
    "qa": "node scripts/qa.cjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "lint:rtl": "node scripts/check-rtl.mjs",
    "tokens": "tsx scripts/build-tokens.ts",
    "images": "tsx scripts/build-images.ts",
    "predev": "npm run tokens && npm run images",
    "prebuild": "npm run tokens && npm run images",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "next": "15.5.29",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "^4.14.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.29",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "wrangler": "^4.158.0"
  },
  "overrides": {
    "postcss": "^8.5.23"
  }
}
